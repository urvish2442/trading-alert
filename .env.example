# ==============================================================================
# NIFTY 50 VWAP + EMA INTRADAY ALERT SYSTEM - ENVIRONMENT VARIABLES (.env.example)
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit real production secrets to git.

# ------------------------------------------------------------------------------
# 1. MONGODB ATLAS DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Full connection string for MongoDB Atlas Free cluster (or local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=trading_alert

# ------------------------------------------------------------------------------
# 2. MARKET DATA PROVIDER CONFIGURATION
# ------------------------------------------------------------------------------
# Provider options: "yahoo" (free demo mode, zero cost) or "kite" (Zerodha Kite Connect)
MARKET_DATA_PROVIDER=yahoo

# ------------------------------------------------------------------------------
# 3. ZERODHA KITE CONNECT V3 CREDENTIALS (Required when MARKET_DATA_PROVIDER=kite)
# ------------------------------------------------------------------------------
# Obtain from your Zerodha Kite Connect developer portal: https://kite.trade/
KITE_API_KEY=your_kite_api_key_here
KITE_API_SECRET=your_kite_api_secret_here
KITE_REDIRECT_URL=http://localhost:3000/api/kite/callback

# ------------------------------------------------------------------------------
# 4. SCHEDULED PROCESSING CRON SECRET (Stateless Serverless Scheduler)
# ------------------------------------------------------------------------------
# High-entropy secret used by external scheduler (cron-job.org / GitHub Actions / EasyCron)
# Must be passed as Authorization: Bearer <CRON_SECRET> or ?secret=<CRON_SECRET>
CRON_SECRET=replace_with_a_random_32_character_secret_key

# ------------------------------------------------------------------------------
# 5. APPLICATION SECURITY & ENCRYPTION
# ------------------------------------------------------------------------------
# 32-byte hexadecimal encryption key for AES-256-GCM encryption of stored broker tokens
# Generate with: openssl rand -hex 32
APP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Secret key for single-user authentication HMAC-SHA256 session tokens / cookies
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace_with_a_secure_session_signing_secret_min_32_chars

# ------------------------------------------------------------------------------
# 6. WEB PUSH NOTIFICATIONS (VAPID)
# ------------------------------------------------------------------------------
# Generate using `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
# Must be a valid email with real domain (e.g. mailto:name@gmail.com) or https:// URL. Apple APNs rejects .local domains.
VAPID_SUBJECT=mailto:your-email@example.com

# ------------------------------------------------------------------------------
# 7. APPLICATION URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
